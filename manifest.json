{
  "manifest_version": 3,
  "name": "Wakyeng PDF SIGN",
  "version": "1.0.0",
  "key": "",
  "description": "Tambahkan tanda tangan/gambar ke PDF di Google Drive langsung dari Chrome.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["identity"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://drive.google.com/*",
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "635710334964-39v2585gqfdk33c4667jrkaoqtj8phhg.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/drive"]
  },
  "content_scripts": [
    {
      "matches": ["https://drive.google.com/file/d/*"],
      "js": ["content-drive.js"],
      "css": ["content-drive.css"],
      "run_at": "document_idle"
    }
  ]
}
